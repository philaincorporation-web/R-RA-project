# ============================================================
# RÈRA — Variables d'environnement
# Copiez ce fichier en ".env.local" et complétez les valeurs.
# ============================================================

# --- SheetDB ---
# URL de base de votre SheetDB (une par Google Sheet connectée).
# ⚠️ Ne jamais exposer une URL SheetDB "d'écriture" avec des droits sensibles
# côté client : ce projet appelle SheetDB uniquement depuis le serveur
# (Route Handlers / fonctions server-only dans src/lib/sheetdb).
SHEETDB_API_URL=https://sheetdb.io/api/v1/xxxxxxxxxxxxx
SHEETDB_API_KEY=

# Feuilles séparées si vous préférez plusieurs Google Sheets / onglets
SHEETDB_PACKAGES_SHEET=packages
SHEETDB_ACTIVITIES_SHEET=activities
SHEETDB_ACCOMMODATION_SHEET=accommodation
SHEETDB_BOOKINGS_SHEET=bookings
SHEETDB_BUSINESS_SHEET=business_requests
SHEETDB_CONTACT_SHEET=contact_messages

# --- Général ---
NEXT_PUBLIC_SITE_URL=https://rera-pointedenis.com
NEXT_PUBLIC_DEFAULT_LOCALE=fr

# --- Contact / notifications (optionnel, V2) ---
CONTACT_NOTIFICATION_EMAIL=rerasupport@gmail.com

# Neon (Postgres + Neon Auth) — remplis automatiquement par `neon link` / `neon deploy`
DATABASE_URL=
NEON_AUTH_BASE_URL=
# Générer avec : openssl rand -base64 32
NEON_AUTH_COOKIE_SECRET=

# --- E-mails (Gmail + Nodemailer) ---
# Envoie une notification à l'équipe et un accusé de réception au visiteur.
# Sans ces deux variables, aucun e-mail n'est envoyé : les demandes restent visibles dans le back-office.
# Équipe : CONTACT_NOTIFICATION_EMAIL (ci-dessus, plusieurs adresses séparées par des virgules), sinon GMAIL_USER.
GMAIL_USER=
# Mot de passe d'application Google (validation en deux étapes requise) :
# https://myaccount.google.com/apppasswords
GMAIL_APP_PASSWORD=

# --- Météo (Open-Meteo, page Infos pratiques) ---
# Facultatif : sans clé, l'API gratuite est utilisée (réservée à un usage non commercial).
# Pour un usage commercial, prendre un abonnement sur https://open-meteo.com/en/pricing et coller la clé ici.
OPEN_METEO_API_KEY=

# --- Assistant IA (Gemini, via le Vercel AI SDK) ---
# Interrupteur : l'assistant n'apparaît que si ASSISTANT_ENABLED=true (lu au build : redéployer après changement).
ASSISTANT_ENABLED=false
# Clé Google AI Studio (https://aistudio.google.com). Ne jamais la commiter.
GEMINI_API_KEY=
# Modèle utilisé (défaut : gemini-3.5-flash).
GEMINI_MODEL=gemini-3.5-flash
# Limites anti-abus et maîtrise des coûts (valeurs par défaut ci-dessous).
ASSISTANT_MAX_MESSAGES_PER_DAY=30
ASSISTANT_MAX_TURNS=20
ASSISTANT_MAX_VISITORS_PER_DAY=1000
