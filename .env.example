# ============================================================
# RÈRA — Variables d'environnement
# Copiez ce fichier en ".env.local" et complétez les valeurs.
# ============================================================

# --- SheetDB ---
# URL de base de votre SheetDB (une par Google Sheet connectée).
# ⚠️ Ne jamais exposer une URL SheetDB "d'écriture" avec des droits sensibles
# côté client : ce projet appelle SheetDB uniquement depuis le serveur
# (Route Handlers / fonctions server-only dans src/lib/sheetdb).
SHEETDB_API_URL=https://sheetdb.io/api/v1/xxxxxxxxxxxxx
SHEETDB_API_KEY=

# Feuilles séparées si vous préférez plusieurs Google Sheets / onglets
SHEETDB_PACKAGES_SHEET=packages
SHEETDB_ACTIVITIES_SHEET=activities
SHEETDB_ACCOMMODATION_SHEET=accommodation
SHEETDB_BOOKINGS_SHEET=bookings
SHEETDB_BUSINESS_SHEET=business_requests
SHEETDB_CONTACT_SHEET=contact_messages

# --- Général ---
NEXT_PUBLIC_SITE_URL=https://rera-pointedenis.com
NEXT_PUBLIC_DEFAULT_LOCALE=fr

# --- Contact / notifications (optionnel, V2) ---
CONTACT_NOTIFICATION_EMAIL=contact@rera-pointedenis.com

# Neon (Postgres + Neon Auth) — remplis automatiquement par `neon link` / `neon deploy`
DATABASE_URL=
NEON_AUTH_BASE_URL=
# Générer avec : openssl rand -base64 32
NEON_AUTH_COOKIE_SECRET=

# --- Notifications e-mail à l'équipe (facultatif, via Resend) ---
# Sans RESEND_API_KEY, aucune notification n'est envoyée : les demandes restent visibles dans le back-office.
# Destinataire : CONTACT_NOTIFICATION_EMAIL (ci-dessus).
RESEND_API_KEY=
# Adresse d'un domaine vérifié dans Resend, ex. RÈRA <notifications@votre-domaine.com>
RESEND_FROM_EMAIL=
